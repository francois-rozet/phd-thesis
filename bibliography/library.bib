@inproceedings{daras2024consistent,
  title = {Consistent Diffusion Meets Tweedie: Training Exact Ambient Diffusion Models with Noisy Data},
  booktitle = {Proceedings of the 41st International Conference on Machine Learning},
  author = {Daras, Giannis and Dimakis, Alex and Daskalakis, Constantinos Costis},
  year = 2024,
  publisher = {PMLR},
  issn = {2640-3498},
  url = {https://proceedings.mlr.press/v235/daras24a.html},
  abstract = {Ambient diffusion is a recently proposed framework for training diffusion models using corrupted data. Both Ambient Diffusion and alternative SURE-based approaches for learning diffusion models from corrupted data resort to approximations which deteriorate performance. We present the first framework for training diffusion models that provably sample from the uncorrupted distribution given only noisy training data, solving an open problem in Ambient diffusion. Our key technical contribution is a method that uses a double application of Tweedie's formula and a consistency loss function that allows us to extend sampling at noise levels below the observed data noise. We also provide further evidence that diffusion models memorize from their training sets by identifying extremely corrupted images that are almost perfectly reconstructed, raising copyright and privacy concerns. Our method for training using corrupted samples can be used to mitigate this problem. We demonstrate this by fine-tuning Stable Diffusion XL to generate samples from a distribution using only noisy samples. Our framework reduces the amount of memorization of the fine-tuning dataset, while maintaining competitive performance.}
}

@article{daras2024learning,
  title = {Learning generative models from corrupted data},
  author = {Daras, Giannis},
  year = 2024,
  url = {https://repositories.lib.utexas.edu/items/882bf643-075e-45c7-a857-bf629d2a8829},
  abstract = {In many applications access to clean data is restricted, expensive, or even impossible, while access to partially corrupted samples is relatively cheap. In the inverse problems literature, generative models are used as unsupervised priors to transform corrupted samples into clean ones. But how can we train these priors in the first place without having access to clean data? In this dissertation, we study the problem of learning diffusion models from corrupted data. We develop Ambient Diffusion, the first framework for learning diffusion models given linear measurements. We extend Ambient Diffusion to handle additive Gaussian noise and we provide the first framework that provably samples from the distribution of interest given (infinite) noisy data. We further explore applications of the developed methods, including MRI acceleration.}
}

@misc{daras2024survey,
  title = {A Survey on Diffusion Models for Inverse Problems},
  author = {Daras, Giannis and Chung, Hyungjin and Lai, Chieh-Hsin and Mitsufuji, Yuki and Ye, Jong Chul and Milanfar, Peyman and Dimakis, Alexandros G. and Delbracio, Mauricio},
  year = 2024,
  number = {arXiv:2410.00083},
  publisher = {arXiv},
  url = {http://arxiv.org/abs/2410.00083},
  abstract = {Diffusion models have become increasingly popular for generative modeling due to their ability to generate high-quality samples. This has unlocked exciting new possibilities for solving inverse problems, especially in image restoration and reconstruction, by treating diffusion models as unsupervised priors. This survey provides a comprehensive overview of methods that utilize pre-trained diffusion models to solve inverse problems without requiring further training. We introduce taxonomies to categorize these methods based on both the problems they address and the techniques they employ. We analyze the connections between different approaches, offering insights into their practical implementation and highlighting important considerations. We further discuss specific challenges and potential solutions associated with using latent diffusion models for inverse problems. This work aims to be a valuable resource for those interested in learning about the intersection of diffusion models and inverse problems.}
}

