@article{zhang2022multisource,
  title = {Multi-source information fused generative adversarial network model and data assimilation based history matching for reservoir with complex geologies},
  author = {Zhang, Kai and Yu, Hai-Qun and Ma, Xiao-Peng and Zhang, Jin-Ding and Wang, Jian and Yao, Chuan-Jin and Yang, Yong-Fei and Sun, Hai and Yao, Jun and Wang, Jian},
